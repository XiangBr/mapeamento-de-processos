        <mxCell id="leg-nota" value="Passe o mouse num passo pra ver o que entra, o que sai e as observações." style="text;html=1;align=left;fontSize=10;fontColor=#78909C;" vertex="1" parent="1"><mxGeometry x="160" y="1064" width="600" height="20" as="geometry" /></mxCell>
