        <mxCell id="r-1-0" value="R2" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#CFD8DC;" vertex="1" parent="1"><mxGeometry x="0" y="150" width="50" height="46" as="geometry" /></mxCell>
        <mxCell id="r-1-1" value="Toda compra fora do orçamento passa pelo diretor, sem valor mínimo." style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#CFD8DC;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="420" height="46" as="geometry" /></mxCell>
