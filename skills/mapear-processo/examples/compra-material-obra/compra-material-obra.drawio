        <mxCell id="r-2-3" value="7. Pede 3 cotações" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#F7F9FA;strokeColor=#CFD8DC;" vertex="1" parent="1"><mxGeometry x="570" y="196" width="220" height="44" as="geometry" /></mxCell>
