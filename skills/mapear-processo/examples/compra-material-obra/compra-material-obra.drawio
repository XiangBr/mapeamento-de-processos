<mxfile host="mapear-processo" agent="mapear-processo">
  <diagram id="fluxo" name="Fluxo">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="titulo" value="&lt;b style=&quot;font-size:20px&quot;&gt;Compra de material para a obra&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#78909C&quot;&gt;Começa quando: O mestre de obras percebe que um material vai faltar&lt;br&gt;Termina com: Material conferido na obra e fornecedor pago&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="3130" height="70" as="geometry" /></mxCell>
        <mxCell id="faixa-0" value="Mestre de obras" style="swimlane;horizontal=0;startSize=130;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fontColor=#263238;fillColor=#F5F7F8;strokeColor=#B0BEC5;swimlaneFillColor=#FFFFFF;collapsible=0;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="3130" height="150" as="geometry" /></mxCell>
        <mxCell id="faixa-1" value="Engenheiro" style="swimlane;horizontal=0;startSize=130;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fontColor=#263238;fillColor=#F5F7F8;strokeColor=#B0BEC5;swimlaneFillColor=#FFFFFF;collapsible=0;" vertex="1" parent="1"><mxGeometry x="0" y="240" width="3130" height="150" as="geometry" /></mxCell>
        <mxCell id="faixa-2" value="Diretor" style="swimlane;horizontal=0;startSize=130;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fontColor=#263238;fillColor=#F5F7F8;strokeColor=#B0BEC5;swimlaneFillColor=#FFFFFF;collapsible=0;" vertex="1" parent="1"><mxGeometry x="0" y="390" width="3130" height="150" as="geometry" /></mxCell>
        <mxCell id="faixa-3" value="Compras" style="swimlane;horizontal=0;startSize=130;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fontColor=#263238;fillColor=#F5F7F8;strokeColor=#B0BEC5;swimlaneFillColor=#FFFFFF;collapsible=0;" vertex="1" parent="1"><mxGeometry x="0" y="540" width="3130" height="150" as="geometry" /></mxCell>
        <mxCell id="faixa-4" value="Fornecedor" style="swimlane;horizontal=0;startSize=130;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fontColor=#263238;fillColor=#F5F7F8;strokeColor=#B0BEC5;swimlaneFillColor=#FFFFFF;collapsible=0;" vertex="1" parent="1"><mxGeometry x="0" y="690" width="3130" height="150" as="geometry" /></mxCell>
        <mxCell id="faixa-5" value="Financeiro" style="swimlane;horizontal=0;startSize=130;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fontColor=#263238;fillColor=#F5F7F8;strokeColor=#B0BEC5;swimlaneFillColor=#FFFFFF;collapsible=0;" vertex="1" parent="1"><mxGeometry x="0" y="840" width="3130" height="150" as="geometry" /></mxCell>
        <UserObject label="&lt;b&gt;Vê que vai faltar material&lt;/b&gt;" tooltip="Entrega: O que falta" id="p1"><mxCell style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;ellipse;fillColor=#E8F5E9;strokeColor=#2E7D32;spacing=12;" vertex="1" parent="faixa-0"><mxGeometry x="190" y="40" width="150" height="70" as="geometry" /></mxCell></UserObject>
        <UserObject label="&lt;b&gt;Pede por áudio&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#78909C&quot;&gt;WhatsApp&lt;/span&gt;" tooltip="Recebe: O que falta (mínimo: material, obra)&#xa;Entrega: Áudio com o pedido&#xa;Pronto quando: Áudio enviado no grupo da obra.&#xa;Obs.: Áudio sem quantidade exata nem especificação. O engenheiro liga de volta pra confirmar." id="p2"><mxCell style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#455A64;fillColor=#E3F2FD;strokeColor=#1565C0;strokeColor=#D32F2F;strokeWidth=2;" vertex="1" parent="faixa-0"><mxGeometry x="395" y="37" width="160" height="76" as="geometry" /></mxCell></UserObject>
        <UserObject label="&lt;b&gt;Confere com o orçamento&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#78909C&quot;&gt;Planilha de orçamento&lt;/span&gt;" tooltip="Recebe: Áudio com o pedido (mínimo: material, quantidade, obra); Orçamento da obra (mínimo: material, quantidade prevista, quantidade já comprada)&#xa;Entrega: Lista de material com quantidade&#xa;Pronto quando: Cada item tem material, quantidade com unidade e obra.&#xa;Tempo: 15 a 30 min" id="p3"><mxCell style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#455A64;" vertex="1" parent="faixa-1"><mxGeometry x="605" y="37" width="160" height="76" as="geometry" /></mxCell></UserObject>
        <UserObject label="&lt;b&gt;Está previsto?&lt;/b&gt;" tooltip="Recebe: Lista de material com quantidade (mínimo: material, quantidade)&#xa;Regras: R1" id="p4"><mxCell style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;rhombus;fillColor=#FFF8E1;strokeColor=#F9A825;" vertex="1" parent="faixa-1"><mxGeometry x="825" y="25" width="140" height="100" as="geometry" /></mxCell></UserObject>
        <UserObject label="&lt;b&gt;Aprova compra fora do orçamento&lt;/b&gt; &lt;span style=&quot;color:#D32F2F&quot;&gt;(?)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#78909C&quot;&gt;WhatsApp&lt;/span&gt;" tooltip="Recebe: Lista de material com quantidade (mínimo: material, quantidade, obra, por que não estava previsto)&#xa;Entrega: Aprovação do diretor&#xa;Pronto quando: Diretor respondeu 'ok' na conversa.&#xa;Regras: R2&#xa;Tempo: 1 a 2 dias parado&#xa;Obs.: Não existe valor mínimo: até compra pequena passa pelo diretor." id="p5"><mxCell style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;rounded=1;arcSize=50;dashed=1;fillColor=#FAFAFA;strokeColor=#78909C;strokeColor=#D32F2F;strokeWidth=2;dashed=1;dashPattern=4 3;" vertex="1" parent="faixa-2"><mxGeometry x="1235" y="42" width="160" height="66" as="geometry" /></mxCell></UserObject>
        <UserObject label="&lt;b&gt;Registra a requisição&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#78909C&quot;&gt;Planilha de compras&lt;/span&gt;" tooltip="Recebe: Lista de material com quantidade (mínimo: obra, material, quantidade e unidade); Aprovação do diretor (mínimo: ok do diretor)&#xa;Entrega: Requisição na planilha&#xa;Pronto quando: Linha criada com todos os campos obrigatórios.&#xa;Tempo: 10 min&#xa;Obs.: Redigita o que veio no WhatsApp. A aprovação do diretor só é exigida quando a compra veio do passo 5." id="p6"><mxCell style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#455A64;fillColor=#E3F2FD;strokeColor=#1565C0;" vertex="1" parent="faixa-3"><mxGeometry x="1445" y="37" width="160" height="76" as="geometry" /></mxCell></UserObject>
        <UserObject label="&lt;b&gt;Pede 3 cotações&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#78909C&quot;&gt;WhatsApp&lt;/span&gt;" tooltip="Recebe: Requisição na planilha (mínimo: material, quantidade e unidade, data limite, endereço da obra); Fornecedores da categoria (mínimo: 3 fornecedores que vendem o material)&#xa;Entrega: Pedido de cotação&#xa;Pronto quando: Mensagem enviada pra 3 fornecedores.&#xa;Regras: R3&#xa;Tempo: 30 min&#xa;Obs.: Mesma mensagem copiada pra cada fornecedor." id="p7"><mxCell style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#455A64;fillColor=#E3F2FD;strokeColor=#1565C0;" vertex="1" parent="faixa-3"><mxGeometry x="1655" y="37" width="160" height="76" as="geometry" /></mxCell></UserObject>
        <UserObject label="&lt;b&gt;Responde a cotação&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#78909C&quot;&gt;WhatsApp&lt;/span&gt;" tooltip="Recebe: Pedido de cotação (mínimo: material, quantidade, endereço de entrega)&#xa;Entrega: Preço e prazo&#xa;Pronto quando: 3 respostas recebidas, ou passou o prazo combinado.&#xa;Tempo: 1 a 3 dias" id="p8"><mxCell style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;rounded=1;arcSize=50;dashed=1;fillColor=#FAFAFA;strokeColor=#78909C;" vertex="1" parent="faixa-4"><mxGeometry x="1865" y="42" width="160" height="66" as="geometry" /></mxCell></UserObject>
        <UserObject label="&lt;b&gt;Escolhe e fecha o pedido&lt;/b&gt; &lt;span style=&quot;color:#D32F2F&quot;&gt;(?)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#78909C&quot;&gt;Planilha de compras&lt;/span&gt;" tooltip="Recebe: Preço e prazo (mínimo: preço unitário, frete, prazo de entrega)&#xa;Entrega: Pedido fechado&#xa;Pronto quando: Fornecedor confirmou o pedido e a data de entrega.&#xa;Regras: R4&#xa;Obs.: Ninguém soube dizer o critério além do preço. Prazo e histórico do fornecedor pesam, mas não estão escritos." id="p9"><mxCell style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#455A64;dashed=1;dashPattern=4 3;" vertex="1" parent="faixa-3"><mxGeometry x="2075" y="37" width="160" height="76" as="geometry" /></mxCell></UserObject>
        <UserObject label="&lt;b&gt;Entrega na obra&lt;/b&gt;" tooltip="Recebe: Pedido fechado (mínimo: material, quantidade, endereço, data)&#xa;Entrega: Material entregue; Nota fiscal em papel&#xa;Pronto quando: Material descarregado e nota entregue pro mestre." id="p10"><mxCell style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#455A64;" vertex="1" parent="faixa-4"><mxGeometry x="2285" y="37" width="160" height="76" as="geometry" /></mxCell></UserObject>
        <UserObject label="&lt;b&gt;Bate com o pedido?&lt;/b&gt;" tooltip="Recebe: Material entregue (mínimo: quantidade contada); Nota fiscal em papel (mínimo: itens, quantidades)&#xa;Regras: R5&#xa;Depende de: Mestre saber o que foi pedido. Hoje ele não vê o pedido fechado.&#xa;Obs.: O mestre confere pela nota, porque não tem o pedido fechado na mão." id="p11"><mxCell style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;rhombus;fillColor=#FFF8E1;strokeColor=#F9A825;strokeColor=#D32F2F;strokeWidth=2;" vertex="1" parent="faixa-0"><mxGeometry x="2505" y="25" width="140" height="100" as="geometry" /></mxCell></UserObject>
        <UserObject label="&lt;b&gt;Avisa compras&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#78909C&quot;&gt;WhatsApp&lt;/span&gt;" tooltip="Entrega: Foto do problema&#xa;Pronto quando: Compras confirmou que viu." id="p12"><mxCell style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#455A64;" vertex="1" parent="faixa-0"><mxGeometry x="2915" y="37" width="160" height="76" as="geometry" /></mxCell></UserObject>
        <UserObject label="&lt;b&gt;Lança a nota fiscal&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#78909C&quot;&gt;ERP&lt;/span&gt;" tooltip="Recebe: Nota fiscal em papel (mínimo: fornecedor, itens, valor, vencimento)&#xa;Entrega: Conta a pagar&#xa;Pronto quando: Conta a pagar lançada com vencimento e obra.&#xa;Depende de: A nota chegar do canteiro até o escritório&#xa;Obs.: A nota vem em papel com o motorista e às vezes se perde no canteiro." id="p13"><mxCell style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#455A64;fillColor=#E3F2FD;strokeColor=#1565C0;strokeColor=#D32F2F;strokeWidth=2;" vertex="1" parent="faixa-5"><mxGeometry x="2705" y="37" width="160" height="76" as="geometry" /></mxCell></UserObject>
        <UserObject label="&lt;b&gt;Paga o fornecedor&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#78909C&quot;&gt;ERP&lt;/span&gt;" tooltip="Recebe: Conta a pagar (mínimo: valor, vencimento)&#xa;Pronto quando: Pagamento feito no vencimento." id="p14"><mxCell style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;ellipse;fillColor=#ECEFF1;strokeColor=#37474F;spacing=12;" vertex="1" parent="faixa-5"><mxGeometry x="2920" y="40" width="150" height="70" as="geometry" /></mxCell></UserObject>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#455A64;fontSize=11;fontColor=#263238;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry" /></mxCell>
