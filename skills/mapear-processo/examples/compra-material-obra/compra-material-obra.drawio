        <mxCell id="leg-0" value="Passo" style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#455A64;fontSize=10;" vertex="1" parent="1"><mxGeometry x="160" y="1020" width="130" height="36" as="geometry" /></mxCell>
