        <mxCell id="r-3-4" value="ninguém soube dizer" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#CFD8DC;fontColor=#D32F2F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="790" y="240" width="170" height="46" as="geometry" /></mxCell>
