        <mxCell id="leg-3" value="Ponto de dor" style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#D32F2F;strokeWidth=2;fontSize=10;" vertex="1" parent="1"><mxGeometry x="610" y="1020" width="130" height="36" as="geometry" /></mxCell>
