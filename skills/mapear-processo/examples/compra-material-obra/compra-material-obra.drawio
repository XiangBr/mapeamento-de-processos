  </diagram>
  <diagram id="entradas-saidas" name="Entradas e saídas">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="titulo" value="&lt;b style=&quot;font-size:20px&quot;&gt;Compra de material para a obra&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#78909C&quot;&gt;O que entra e o que sai em cada passo&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1260" height="60" as="geometry" /></mxCell>
        <mxCell id="t-h-0" value="Passo" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;align=left;spacingLeft=8;fontStyle=1;fillColor=#263238;fontColor=#FFFFFF;strokeColor=#263238;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="190" height="34" as="geometry" /></mxCell>
        <mxCell id="t-h-1" value="Quem" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;align=left;spacingLeft=8;fontStyle=1;fillColor=#263238;fontColor=#FFFFFF;strokeColor=#263238;" vertex="1" parent="1"><mxGeometry x="190" y="70" width="120" height="34" as="geometry" /></mxCell>
