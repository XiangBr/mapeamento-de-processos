        <mxCell id="r-1-3" value="5. Aprova compra fora do orçamento" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#CFD8DC;" vertex="1" parent="1"><mxGeometry x="570" y="150" width="220" height="46" as="geometry" /></mxCell>
        <mxCell id="r-1-4" value="existe, mas não está escrita" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#CFD8DC;fontColor=#D32F2F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="790" y="150" width="170" height="46" as="geometry" /></mxCell>
        <mxCell id="r-2-0" value="R3" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#F7F9FA;strokeColor=#CFD8DC;" vertex="1" parent="1"><mxGeometry x="0" y="196" width="50" height="44" as="geometry" /></mxCell>
        <mxCell id="r-2-1" value="Toda compra precisa de 3 cotações." style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#F7F9FA;strokeColor=#CFD8DC;" vertex="1" parent="1"><mxGeometry x="50" y="196" width="420" height="44" as="geometry" /></mxCell>
