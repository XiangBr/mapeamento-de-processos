        <mxCell id="r-4-1" value="A entrega bate quando material, quantidade e especificação da nota são iguais aos do pedido fechado." style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#F7F9FA;strokeColor=#CFD8DC;" vertex="1" parent="1"><mxGeometry x="50" y="286" width="420" height="46" as="geometry" /></mxCell>
