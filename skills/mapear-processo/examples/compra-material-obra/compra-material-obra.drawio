        <mxCell id="r-0-3" value="4. Está previsto?" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#F7F9FA;strokeColor=#CFD8DC;" vertex="1" parent="1"><mxGeometry x="570" y="104" width="220" height="46" as="geometry" /></mxCell>
