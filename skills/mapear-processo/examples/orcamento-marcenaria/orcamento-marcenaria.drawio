        <mxCell id="titulo" value="&lt;b style=&quot;font-size:20px&quot;&gt;Orçamento de móveis planejados&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#78909C&quot;&gt;Regras de negócio. O que não está confirmado, um agente ainda não consegue seguir.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="960" height="60" as="geometry" /></mxCell>
