<mxfile host="mapear-processo" agent="mapear-processo">
  <diagram id="fluxo" name="Fluxo">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="titulo" value="&lt;b style=&quot;font-size:20px&quot;&gt;Orçamento de móveis planejados&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#78909C&quot;&gt;Começa quando: Cliente pede orçamento pelo WhatsApp ou Instagram&lt;br&gt;Termina com: Pedido fechado, com sinal pago e projeto liberado pra produção&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2290" height="70" as="geometry" /></mxCell>
        <mxCell id="faixa-0" value="Cliente" style="swimlane;horizontal=0;startSize=130;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fontColor=#263238;fillColor=#F5F7F8;strokeColor=#B0BEC5;swimlaneFillColor=#FFFFFF;collapsible=0;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="2290" height="150" as="geometry" /></mxCell>
        <mxCell id="faixa-1" value="Comercial" style="swimlane;horizontal=0;startSize=130;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fontColor=#263238;fillColor=#F5F7F8;strokeColor=#B0BEC5;swimlaneFillColor=#FFFFFF;collapsible=0;" vertex="1" parent="1"><mxGeometry x="0" y="240" width="2290" height="150" as="geometry" /></mxCell>
        <mxCell id="faixa-2" value="Projetista" style="swimlane;horizontal=0;startSize=130;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fontColor=#263238;fillColor=#F5F7F8;strokeColor=#B0BEC5;swimlaneFillColor=#FFFFFF;collapsible=0;" vertex="1" parent="1"><mxGeometry x="0" y="390" width="2290" height="150" as="geometry" /></mxCell>
        <mxCell id="faixa-3" value="Financeiro" style="swimlane;horizontal=0;startSize=130;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fontColor=#263238;fillColor=#F5F7F8;strokeColor=#B0BEC5;swimlaneFillColor=#FFFFFF;collapsible=0;" vertex="1" parent="1"><mxGeometry x="0" y="540" width="2290" height="150" as="geometry" /></mxCell>
        <UserObject label="&lt;b&gt;Pede orçamento&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#78909C&quot;&gt;WhatsApp&lt;/span&gt;" tooltip="Entrega: Mensagem do cliente" id="p1"><mxCell style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;ellipse;fillColor=#E8F5E9;strokeColor=#2E7D32;spacing=12;" vertex="1" parent="faixa-0"><mxGeometry x="190" y="40" width="150" height="70" as="geometry" /></mxCell></UserObject>
        <UserObject label="&lt;b&gt;Registra o contato&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#78909C&quot;&gt;Planilha de leads&lt;/span&gt;" tooltip="Recebe: Mensagem do cliente (mínimo: nome, telefone, ambiente)&#xa;Entrega: Lead na planilha&#xa;Pronto quando: A linha existe com nome, telefone, ambiente e status 'novo'.&#xa;Tempo: 5 min&#xa;Obs.: Copia e cola na mão. Às vezes esquece e o lead some." id="p2"><mxCell style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#455A64;fillColor=#E3F2FD;strokeColor=#1565C0;" vertex="1" parent="faixa-1"><mxGeometry x="395" y="37" width="160" height="76" as="geometry" /></mxCell></UserObject>
        <UserObject label="&lt;b&gt;Agenda a medição&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#78909C&quot;&gt;WhatsApp&lt;/span&gt;" tooltip="Recebe: Lead na planilha (mínimo: telefone, ambiente, bairro); Agenda do projetista (mínimo: dias e horários livres na semana)&#xa;Entrega: Visita marcada&#xa;Pronto quando: Cliente confirmou data, hora e endereço por escrito.&#xa;Regras: R1&#xa;Tempo: 1 a 3 dias de troca de mensagem&#xa;Obs.: A troca de mensagem pra achar horário leva até 3 dias." id="p3"><mxCell style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#455A64;strokeColor=#D32F2F;strokeWidth=2;" vertex="1" parent="faixa-1"><mxGeometry x="605" y="37" width="160" height="76" as="geometry" /></mxCell></UserObject>
        <UserObject label="&lt;b&gt;Mede o ambiente&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#78909C&quot;&gt;Caderno&lt;/span&gt;" tooltip="Recebe: Visita marcada (mínimo: endereço completo, data e hora)&#xa;Entrega: Medidas do ambiente; Preferências do cliente&#xa;Pronto quando: Todas as paredes do ambiente medidas, com pontos de água e luz marcados.&#xa;Tempo: 1h30 no local" id="p4"><mxCell style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#455A64;" vertex="1" parent="faixa-2"><mxGeometry x="815" y="37" width="160" height="76" as="geometry" /></mxCell></UserObject>
        <UserObject label="&lt;b&gt;Desenha o projeto&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#78909C&quot;&gt;Promob&lt;/span&gt;" tooltip="Recebe: Medidas do ambiente (mínimo: paredes, pé-direito, pontos de água e luz); Preferências do cliente (mínimo: cor); Pedido de ajuste (mínimo: o que mudar)&#xa;Entrega: Projeto 3D; Lista de peças&#xa;Pronto quando: Projeto renderizado e lista de peças exportada.&#xa;Depende de: Medidas passadas do caderno pro computador&#xa;Tempo: 1 a 2 dias&#xa;Obs.: Na primeira vez entra sem pedido de ajuste. O pedido de ajuste só existe quando o cliente volta do passo 8." id="p5"><mxCell style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#455A64;" vertex="1" parent="faixa-2"><mxGeometry x="1025" y="37" width="160" height="76" as="geometry" /></mxCell></UserObject>
        <UserObject label="&lt;b&gt;Calcula o preço&lt;/b&gt; &lt;span style=&quot;color:#D32F2F&quot;&gt;(?)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#78909C&quot;&gt;Planilha de custos&lt;/span&gt;" tooltip="Recebe: Lista de peças (mínimo: material / cor da chapa, medidas, quantidade); Tabela de preço de chapa (mínimo: preço por chapa de cada material e cor)&#xa;Entrega: Preço final&#xa;Regras: R2, R3&#xa;Tempo: ?&#xa;Obs.: Ninguém soube dizer com que frequência a tabela de chapa é atualizada, nem quanto tempo o cálculo leva." id="p6"><mxCell style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#455A64;fillColor=#E3F2FD;strokeColor=#1565C0;dashed=1;dashPattern=4 3;" vertex="1" parent="faixa-3"><mxGeometry x="1235" y="37" width="160" height="76" as="geometry" /></mxCell></UserObject>
        <UserObject label="&lt;b&gt;Apresenta a proposta&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#78909C&quot;&gt;WhatsApp&lt;/span&gt;" tooltip="Recebe: Projeto 3D (mínimo: imagens de todos os ambientes orçados); Preço final (mínimo: preço à vista, preço parcelado)&#xa;Entrega: Proposta em PDF&#xa;Pronto quando: PDF enviado e cliente visualizou.&#xa;Regras: R4, R6" id="p7"><mxCell style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#455A64;" vertex="1" parent="faixa-1"><mxGeometry x="1445" y="37" width="160" height="76" as="geometry" /></mxCell></UserObject>
        <UserObject label="&lt;b&gt;Aprova?&lt;/b&gt;" tooltip="Recebe: Proposta em PDF (mínimo: preço, imagens)&#xa;Entrega: Proposta aprovada; Pedido de ajuste&#xa;Regras: R5" id="p8"><mxCell style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;rhombus;fillColor=#FFF8E1;strokeColor=#F9A825;" vertex="1" parent="faixa-0"><mxGeometry x="1665" y="25" width="140" height="100" as="geometry" /></mxCell></UserObject>
        <UserObject label="&lt;b&gt;Emite contrato e cobra o sinal&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#78909C&quot;&gt;Conta Azul&lt;/span&gt;" tooltip="Recebe: Proposta aprovada (mínimo: valor fechado, forma de pagamento); Dados do cliente pro contrato (mínimo: nome completo, CPF, endereço da obra)&#xa;Entrega: Contrato assinado; Sinal pago&#xa;Pronto quando: Contrato assinado pelas duas partes e boleto do sinal emitido.&#xa;Tempo: 1 dia&#xa;Obs.: Redigita no Conta Azul os dados do cliente que já estavam na planilha de leads." id="p9"><mxCell style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#455A64;strokeColor=#D32F2F;strokeWidth=2;" vertex="1" parent="faixa-3"><mxGeometry x="1865" y="37" width="160" height="76" as="geometry" /></mxCell></UserObject>
        <UserObject label="&lt;b&gt;Libera pra produção&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#78909C&quot;&gt;Promob&lt;/span&gt;" tooltip="Recebe: Sinal pago (mínimo: 50% do valor compensado); Projeto 3D (mínimo: versão aprovada pelo cliente)&#xa;Entrega: Plano de corte&#xa;Pronto quando: Plano de corte entregue pra fábrica.&#xa;Regras: R7" id="p10"><mxCell style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;ellipse;fillColor=#ECEFF1;strokeColor=#37474F;spacing=12;" vertex="1" parent="faixa-2"><mxGeometry x="2080" y="40" width="150" height="70" as="geometry" /></mxCell></UserObject>
        <UserObject label="&lt;b&gt;Marca como perdido&lt;/b&gt; &lt;span style=&quot;color:#D32F2F&quot;&gt;(?)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#78909C&quot;&gt;Planilha de leads&lt;/span&gt;" tooltip="Pronto quando: Status 'perdido' na planilha.&#xa;Obs.: O motivo da perda não é registrado." id="p11"><mxCell style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;ellipse;fillColor=#ECEFF1;strokeColor=#37474F;spacing=12;dashed=1;dashPattern=4 3;" vertex="1" parent="faixa-1"><mxGeometry x="2080" y="40" width="150" height="70" as="geometry" /></mxCell></UserObject>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#455A64;fontSize=11;fontColor=#263238;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry" /></mxCell>
