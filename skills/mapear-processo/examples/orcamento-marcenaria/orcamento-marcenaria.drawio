        <mxCell id="leg-4" value="Candidato a automação" style="whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;rounded=1;arcSize=10;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="760" y="720" width="130" height="36" as="geometry" /></mxCell>
