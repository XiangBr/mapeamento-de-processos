        <mxCell id="r-3-1" value="Desconto acima de 5% só com aprovação do dono." style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#CFD8DC;" vertex="1" parent="1"><mxGeometry x="50" y="240" width="420" height="44" as="geometry" /></mxCell>
