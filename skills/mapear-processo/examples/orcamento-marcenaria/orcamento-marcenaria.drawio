        <mxCell id="titulo" value="&lt;b style=&quot;font-size:20px&quot;&gt;Orçamento de móveis planejados&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#78909C&quot;&gt;O que entra e o que sai em cada passo&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1260" height="60" as="geometry" /></mxCell>
        <mxCell id="t-h-0" value="Passo" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;align=left;spacingLeft=8;fontStyle=1;fillColor=#263238;fontColor=#FFFFFF;strokeColor=#263238;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="190" height="34" as="geometry" /></mxCell>
        <mxCell id="t-h-1" value="Quem" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;align=left;spacingLeft=8;fontStyle=1;fillColor=#263238;fontColor=#FFFFFF;strokeColor=#263238;" vertex="1" parent="1"><mxGeometry x="190" y="70" width="120" height="34" as="geometry" /></mxCell>
        <mxCell id="t-h-2" value="Ferramenta" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;align=left;spacingLeft=8;fontStyle=1;fillColor=#263238;fontColor=#FFFFFF;strokeColor=#263238;" vertex="1" parent="1"><mxGeometry x="310" y="70" width="120" height="34" as="geometry" /></mxCell>
        <mxCell id="t-h-3" value="Precisa ter pra começar" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;align=left;spacingLeft=8;fontStyle=1;fillColor=#263238;fontColor=#FFFFFF;strokeColor=#263238;" vertex="1" parent="1"><mxGeometry x="430" y="70" width="250" height="34" as="geometry" /></mxCell>
        <mxCell id="t-h-4" value="Entrega" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;align=left;spacingLeft=8;fontStyle=1;fillColor=#263238;fontColor=#FFFFFF;strokeColor=#263238;" vertex="1" parent="1"><mxGeometry x="680" y="70" width="210" height="34" as="geometry" /></mxCell>
        <mxCell id="t-h-5" value="Pronto quando" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;align=left;spacingLeft=8;fontStyle=1;fillColor=#263238;fontColor=#FFFFFF;strokeColor=#263238;" vertex="1" parent="1"><mxGeometry x="890" y="70" width="190" height="34" as="geometry" /></mxCell>
        <mxCell id="t-h-6" value="Regras" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;align=left;spacingLeft=8;fontStyle=1;fillColor=#263238;fontColor=#FFFFFF;strokeColor=#263238;" vertex="1" parent="1"><mxGeometry x="1080" y="70" width="80" height="34" as="geometry" /></mxCell>
        <mxCell id="t-h-7" value="Tempo" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;align=left;spacingLeft=8;fontStyle=1;fillColor=#263238;fontColor=#FFFFFF;strokeColor=#263238;" vertex="1" parent="1"><mxGeometry x="1160" y="70" width="100" height="34" as="geometry" /></mxCell>
        <mxCell id="t-0-0" value="1. Pede orçamento" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#F7F9FA;strokeColor=#CFD8DC;" vertex="1" parent="1"><mxGeometry x="0" y="104" width="190" height="44" as="geometry" /></mxCell>
        <mxCell id="t-0-1" value="Cliente" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#F7F9FA;strokeColor=#CFD8DC;" vertex="1" parent="1"><mxGeometry x="190" y="104" width="120" height="44" as="geometry" /></mxCell>
        <mxCell id="t-0-2" value="WhatsApp" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontColor=#263238;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#F7F9FA;strokeColor=#CFD8DC;" vertex="1" parent="1"><mxGeometry x="310" y="104" width="120" height="44" as="geometry" /></mxCell>
